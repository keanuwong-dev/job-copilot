{
  "name": "job-tracker",
  "private": true,
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:extension": "pnpm --filter extension dev",
    "lint": "eslint . && pnpm --filter web lint",
    "test": "pnpm --filter @job-tracker/shared test && pnpm --filter extension test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.3"
  }
}
